# Postgres (Neon in production — https://neon.tech). Locally, docker-compose
# provides a matching Postgres instance; point both URLs at it or at Neon.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Neon: same as DATABASE_URL but without the "-pooler" host segment — used
# only for migrations, which need a direct (non-pgbouncer) connection.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth — generate with `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
